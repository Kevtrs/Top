rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupId is string
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupData(groupId).memberIds.hasAny([request.auth.uid]);
    }

    function canReadUser(uid) {
      return isSelf(uid)
        || (userData(uid).privacy == 'group' && isGroupMember(userData(uid).primaryGroupId));
    }

    function validProfile(uid) {
      return request.resource.data.id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.privacy in ['group', 'private']
        && request.resource.data.primaryGroupId is string;
    }

    function validMovieWrite(uid) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.groupId == userData(uid).primaryGroupId
        && request.resource.data.id is int
        && request.resource.data.title is string;
    }

    match /users/{uid} {
      allow create: if isSelf(uid) && validProfile(uid);
      allow read: if canReadUser(uid);
      allow update: if isSelf(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && validProfile(uid);
      allow delete: if isSelf(uid);

      match /{movieType}/{movieId} {
        allow read: if movieType in ['rankings', 'watched', 'watchlist'] && canReadUser(uid);
        allow create, update: if movieType in ['rankings', 'watched', 'watchlist']
          && isSelf(uid)
          && validMovieWrite(uid);
        allow delete: if movieType in ['rankings', 'watched', 'watchlist'] && isSelf(uid);
      }

      match /inbox/{recoId} {
        allow read: if isSelf(uid)
          || (signedIn() && resource.data.from == request.auth.uid && isGroupMember(resource.data.groupId));
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to == uid
          && request.resource.data.groupId == userData(uid).primaryGroupId
          && isGroupMember(request.resource.data.groupId);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
        allow delete: if isSelf(uid) || (signedIn() && resource.data.from == request.auth.uid);
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isSelf(uid);
      }

      match /private/{documentId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if signedIn() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberIds', 'joinCode', 'updatedAt'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinCode', 'updatedAt'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAny([request.auth.uid])
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.groupId == groupId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.expiresAt > request.time.toMillis()
        )
        || (
          resource.data.ownerUid != request.auth.uid
          && resource.data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !request.resource.data.memberIds.hasAny([request.auth.uid])
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.query.limit <= 50;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.expiresAt > request.time.toMillis();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    match /movieNights/{nightId} {
      function isNightParticipant() {
        return signedIn() && resource.data.participantIds.hasAny([request.auth.uid]);
      }
      function isNightInvited() {
        return signedIn() && resource.data.invitedIds.hasAny([request.auth.uid]);
      }

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.groupId == userData(request.auth.uid).primaryGroupId
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.status == 'collecting';

      allow read: if isNightParticipant() || isNightInvited();

      allow update: if signedIn() && (
        (
          // Un invité accepte : passe de invitedIds vers participantIds, rien d'autre ne bouge.
          isNightInvited()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedIds', 'participantIds', 'updatedAt'])
          && request.resource.data.invitedIds.size() == resource.data.invitedIds.size() - 1
          && !request.resource.data.invitedIds.hasAny([request.auth.uid])
          && request.resource.data.participantIds == resource.data.participantIds.concat([request.auth.uid])
        )
        || (
          // Un invité refuse : quitte simplement invitedIds.
          isNightInvited()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedIds', 'updatedAt'])
          && request.resource.data.invitedIds.size() == resource.data.invitedIds.size() - 1
          && !request.resource.data.invitedIds.hasAny([request.auth.uid])
        )
        || (
          // Le host ajoute des invités tant que la soirée est encore en collecte.
          resource.data.hostUid == request.auth.uid
          && resource.data.status == 'collecting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedIds', 'updatedAt'])
          && request.resource.data.invitedIds.hasAll(resource.data.invitedIds)
        )
        || (
          // Un participant quitte la soirée pendant la collecte (l'hôte, lui, l'annule).
          isNightParticipant()
          && resource.data.hostUid != request.auth.uid
          && resource.data.status == 'collecting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'picks', 'updatedAt'])
          && !request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1
        )
        || (
          // Un participant choisit ou retire son film pour la soirée (sa propre entrée uniquement).
          isNightParticipant()
          && resource.data.status == 'collecting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'updatedAt'])
          && request.resource.data.picks.diff(resource.data.picks).affectedKeys().hasOnly([request.auth.uid])
        )
        || (
          // Le host lance le vote : fixe les candidats, leur provenance, et remet les votes à zéro.
          resource.data.hostUid == request.auth.uid
          && resource.data.status == 'collecting'
          && request.resource.data.status == 'voting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'candidates', 'candidateSources', 'votes', 'updatedAt'])
        )
        || (
          // Un participant vote (ne peut modifier que sa propre entrée).
          isNightParticipant()
          && resource.data.status == 'voting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'updatedAt'])
          && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
        )
        || (
          // Un participant révèle le résultat (déclenché à la main ou automatiquement quand tout le monde a voté).
          isNightParticipant()
          && resource.data.status == 'voting'
          && request.resource.data.status == 'revealed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerMovieId', 'tieBreak', 'updatedAt'])
        )
        || (
          // Le host relance un vote sans le film gagnant.
          resource.data.hostUid == request.auth.uid
          && resource.data.status == 'revealed'
          && request.resource.data.status == 'voting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'candidates', 'candidateSources', 'votes', 'winnerMovieId', 'tieBreak', 'updatedAt'])
        )
        || (
          // Le host clôt la soirée.
          resource.data.hostUid == request.auth.uid
          && request.resource.data.status == 'done'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    // Système legacy (profils par nom) : redevenu le mode de fonctionnement principal de l'app.
    // list ajouté pour que l'onglet Amis affiche tous les profils du foyer, comme avant les comptes secure.
    match /{legacyCollection}/{legacyId} {
      allow get: if signedIn()
        && legacyCollection in ['profiles', 'profileIndex', 'rankings', 'watched', 'watchlist', 'recoPrefs'];
      allow list: if signedIn()
        && legacyCollection in ['profiles', 'profileIndex', 'rankings', 'watched', 'watchlist'];
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData(request.auth.uid).legacyProfileId == legacyId;
      allow create, update: if false;
    }

    match /pushTokens/{legacyId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
